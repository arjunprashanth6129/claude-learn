#!/usr/bin/env python3
"""learn — an AI teacher in your terminal (Claude Code port of amosblomqvist/learn).

Usage:
  learn                         start a learning session in this folder
  learn "what you want to learn"  start the session with your first message
  learn --log notes/topic.md    mirror the lesson into this markdown file
  learn --no-log                don't write a lesson log
  learn --research "question"   one-off: run only the researcher and print its brief

In the session, just type. The teacher probes what you know with quiz popups,
proposes a plan, then teaches step by step. Type /exit (or Ctrl+D) to leave.

Sessions always run in a Learning folder inside your Obsidian vault (never your
home folder). Each lesson is mirrored to Learning/lessons/<date>-<topic>.md and
opened in Obsidian, so math, diagrams and images render as you go.

Env:
  LEARN_DIR         folder to learn in (default: <your Obsidian vault>/Learning)
  LEARN_MODEL       model for the teacher and its helpers (default: sonnet)
  LEARN_EFFORT      teacher effort (default: medium)
  LEARN_BUDGET_USD  spending cap for --research runs (default 0.50)
"""
import datetime
import glob
import json
import os
import re
import shutil
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
MODEL = os.environ.get("LEARN_MODEL", "sonnet")
EFFORT = os.environ.get("LEARN_EFFORT", "medium")
BUDGET = os.environ.get("LEARN_BUDGET_USD", "0.50")
# Only what the teacher and its helpers use. --tools caps subagents too, and every
# tool left out (plus MCP servers and skill listings) is context not paid for on each turn.
SESSION_TOOLS = "Agent,AskUserQuestion,Read,Write,Edit,Bash,WebSearch,WebFetch"
CACHE = os.path.join(ROOT, ".cache")
OBSIDIAN_CONFIG = os.path.expanduser("~/Library/Application Support/obsidian/obsidian.json")

DIM, BOLD, RED, RESET = ("\033[2m", "\033[1m", "\033[31m", "\033[0m") if sys.stderr.isatty() else ("",) * 4


def read_agent(path):
    text = open(path, encoding="utf-8").read()
    _, head, body = text.split("---", 2)
    meta = {}
    for line in head.strip().splitlines():
        key, _, value = line.partition(":")
        meta[key.strip()] = value.strip()
    return meta, body.strip() + "\n"


def skill_body(path):
    text = open(path, encoding="utf-8").read()
    return text.split("---", 2)[2].strip() if text.startswith("---") else text.strip()


def agents_json():
    agents = {}
    for path in sorted(glob.glob(os.path.join(ROOT, "agents", "*.md"))):
        meta, body = read_agent(path)
        agents[meta["name"]] = {
            "description": meta.get("description", ""),
            "prompt": body,
            "tools": [t.strip() for t in meta.get("tools", "").split(",") if t.strip()],
            "model": os.environ.get("LEARN_MODEL", meta.get("model", MODEL)),
            "effort": meta.get("effort", "medium"),
        }
    return agents


def obsidian_vaults():
    """Vault paths Obsidian knows about, the open/most recent one first."""
    try:
        vaults = json.load(open(OBSIDIAN_CONFIG, encoding="utf-8")).get("vaults", {}).values()
    except (OSError, json.JSONDecodeError):
        return []
    ranked = sorted(vaults, key=lambda v: (bool(v.get("open")), v.get("ts", 0)), reverse=True)
    return [v["path"] for v in ranked if os.path.isdir(v.get("path", ""))]


def learn_dir():
    if os.environ.get("LEARN_DIR"):
        return os.path.abspath(os.path.expanduser(os.environ["LEARN_DIR"]))
    vaults = obsidian_vaults()
    return os.path.join(vaults[0], "Learning") if vaults else os.path.expanduser("~/Learning")


def in_vault(path):
    return any(os.path.abspath(path).startswith(os.path.abspath(v) + os.sep) for v in obsidian_vaults())


def open_in_obsidian(path):
    if not in_vault(path) or not shutil.which("open"):
        return False
    from urllib.parse import quote
    subprocess.run(["open", "obsidian://open?path=" + quote(path, safe="")],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return True


def hook(script):
    return {"type": "command", "command": f'python3 "{os.path.join(ROOT, "hooks", script)}"'}


def session_settings(log):
    hooks = {
        "PreToolUse": [{"matcher": "Bash", "hooks": [hook("safe-bash.py")]}],
        "PostToolUse": [{"matcher": "AskUserQuestion", "hooks": [hook("quiz.py")]}],
    }
    if log:
        md = hook("md-log.py")
        hooks["UserPromptSubmit"] = [{"hooks": [md]}]
        hooks["PreToolUse"].append({"matcher": "AskUserQuestion", "hooks": [md]})
        hooks["PostToolUse"].append({"matcher": "AskUserQuestion", "hooks": [md]})
        hooks["Stop"] = [{"hooks": [md]}]
    # pi runs tools without asking; safe-bash still blocks dangerous commands.
    return {"hooks": hooks, "permissions": {"allow": ["Bash", "Read", "WebSearch", "WebFetch"]}}


def slugify(text, limit=40):
    s = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    return s[:limit].rstrip("-")


def default_log(topic):
    stamp = datetime.datetime.now().strftime("%Y-%m-%d-%H%M")
    slug = slugify(topic) if topic else ""
    return os.path.join("lessons", f"{stamp}-{slug}.md" if slug else f"{stamp}.md")


def teacher_prompt(log):
    template = open(os.path.join(ROOT, "system", "teacher.md"), encoding="utf-8").read()
    log_line = (f"everything you write, plus each quiz/question and its answer, is mirrored live to `{log}`, "
                "which the learner reads rendered in Obsidian. Images saved in `viz/` embed with `![[filename.png|500]]`."
                if log else "no lesson log is linked this session; everything is read in the terminal.")
    return (template.replace("{{LOG_LINE}}", log_line)
            .replace("{{TEACH_SKILL}}", skill_body(os.path.join(ROOT, "skills", "teach", "SKILL.md")))
            .replace("{{VISUALIZE_SKILL}}", skill_body(os.path.join(ROOT, "skills", "visualize", "SKILL.md"))))


def pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def write_cache(name, content):
    os.makedirs(CACHE, exist_ok=True)
    # Each file is named <kind>-<pid>.md; drop the ones whose session has ended.
    for old in glob.glob(os.path.join(CACHE, "*-*.md")):
        pid = os.path.basename(old).rsplit("-", 1)[-1][:-3]
        if pid.isdigit() and not pid_alive(int(pid)):
            os.remove(old)
    path = os.path.join(CACHE, name)
    with open(path, "w", encoding="utf-8") as f:
        f.write(content)
    return path


def start_session(topic, log, workdir):
    # Never run in the home folder: Claude Code looks through its working folder,
    # and in ~ that means Photos, Music and other apps' data (macOS privacy prompts).
    os.makedirs(workdir, exist_ok=True)
    os.chdir(workdir)
    if log:
        log = os.path.abspath(log)
        os.makedirs(os.path.dirname(log), exist_ok=True)
        if not os.path.exists(log):
            title = topic.strip().rstrip("?.!") if topic else "Lesson"
            with open(log, "w", encoding="utf-8") as f:
                f.write(f"# {title[:80]}\n\n*{datetime.datetime.now().strftime('%d %b %Y, %H:%M')}*\n")
    prompt_file = write_cache(f"teacher-{os.getpid()}.md", teacher_prompt(log))

    env = dict(os.environ)
    env["PATH"] = os.path.join(ROOT, "bin") + ":" + env.get("PATH", "")
    # Subagents return their result directly (pi steered results back the same way)
    # instead of running in the background and interrupting with notifications.
    env["CLAUDE_CODE_DISABLE_BACKGROUND_TASKS"] = "1"
    if log:
        env["LEARN_LOG_FILE"] = log
    else:
        env.pop("LEARN_LOG_FILE", None)

    cmd = [
        "claude",
        "--model", MODEL,
        "--effort", EFFORT,
        "--tools", SESSION_TOOLS,
        "--strict-mcp-config",
        "--disable-slash-commands",
        "--permission-mode", "acceptEdits",
        "--agents", json.dumps(agents_json()),
        "--append-system-prompt-file", prompt_file,
        "--settings", json.dumps(session_settings(log)),
        "-n", "learn" + (f": {topic[:40]}" if topic else ""),
    ]
    if topic:
        cmd.append(topic)

    print(f"{BOLD}learn{RESET}{DIM} · {MODEL} · effort {EFFORT} · {workdir}{RESET}", file=sys.stderr)
    if log:
        if open_in_obsidian(log):
            print(f"{DIM}lesson opened in Obsidian: {os.path.relpath(log)}{RESET}", file=sys.stderr)
        else:
            print(f"{DIM}lesson log: {log}\n(open {workdir} as an Obsidian vault to read it rendered){RESET}", file=sys.stderr)
    os.execvpe("claude", cmd, env)


# --- one-off researcher (learn --research "question") ---

def describe(name, args):
    if name == "WebSearch":
        return f"web_search  {args.get('query', '')}"
    if name == "WebFetch":
        return f"web_fetch   {args.get('url', '')}"
    if name == "Bash":
        cmd = (args.get("command") or "").splitlines()
        return f"safe_bash   {cmd[0][:120] if cmd else ''}"
    return name


def research(question):
    meta, body = read_agent(os.path.join(ROOT, "agents", "researcher.md"))
    model = os.environ.get("LEARN_MODEL", meta.get("model", MODEL))
    effort = meta.get("effort", "medium")
    tools = ",".join(t.strip() for t in meta["tools"].split(","))
    prompt_file = write_cache(f"researcher-{os.getpid()}.md", body)
    settings = {"hooks": {"PreToolUse": [{"matcher": "Bash", "hooks": [hook("safe-bash.py")]}]}}
    cmd = [
        "claude", "-p",
        "--model", model, "--effort", effort,
        "--tools", tools, "--allowedTools", tools,
        "--permission-mode", "dontAsk",
        "--strict-mcp-config", "--disable-slash-commands",
        "--append-system-prompt-file", prompt_file,
        "--settings", json.dumps(settings),
        "--max-budget-usd", BUDGET,
        "--no-session-persistence",
        "--output-format", "stream-json", "--verbose",
        question,
    ]
    os.chdir(learn_dir() if os.path.isdir(learn_dir()) else ROOT)
    print(f"{BOLD}researcher{RESET}{DIM} · {model} · effort {effort}{RESET}", file=sys.stderr)
    final, result = None, None
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True, stdin=subprocess.DEVNULL)
    try:
        for line in proc.stdout:
            try:
                ev = json.loads(line)
            except json.JSONDecodeError:
                continue
            if ev.get("type") == "assistant":
                texts = []
                for block in ev.get("message", {}).get("content", []):
                    if block.get("type") == "tool_use":
                        print(f"{DIM}  {describe(block.get('name', ''), block.get('input') or {})}{RESET}", file=sys.stderr, flush=True)
                    elif block.get("type") == "text" and block.get("text", "").strip():
                        texts.append(block["text"])
                if texts:
                    final = "\n".join(texts)
            elif ev.get("type") == "result":
                result = ev
        proc.wait()
    except KeyboardInterrupt:
        proc.terminate()
        sys.exit(130)
    finally:
        os.remove(prompt_file)
    if result and result.get("result"):
        final = result["result"]
    if result:
        cost = result.get("total_cost_usd")
        print(f"{DIM}done · {result.get('num_turns')} turns" + (f" · ${cost:.4f}" if cost is not None else "") + RESET, file=sys.stderr)
        if result.get("is_error") or result.get("subtype", "success") != "success":
            print(f"{RED}researcher stopped: {result.get('subtype')}{RESET}", file=sys.stderr)
    print(file=sys.stderr)
    if final:
        print(final.strip())
    sys.exit(0 if final else 1)


def main():
    args = sys.argv[1:]
    if args[:1] in (["-h"], ["--help"]):
        print(__doc__.strip())
        return
    if not shutil.which("claude"):
        sys.exit("learn: the `claude` CLI is not on your PATH — install Claude Code first: https://code.claude.com")

    log, no_log, words = None, False, []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--research":
            question = " ".join(args[i + 1:]).strip()
            if not question and not sys.stdin.isatty():
                question = sys.stdin.read().strip()
            if not question:
                sys.exit('usage: learn --research "your question"')
            return research(question)
        if a == "--log":
            if i + 1 >= len(args):
                sys.exit("usage: learn --log path/to/notes.md")
            log = args[i + 1]
            i += 2
            continue
        if a == "--no-log":
            no_log = True
        elif a.startswith("-"):
            sys.exit(f"learn: unknown option {a} (see learn --help)")
        else:
            words.append(a)
        i += 1

    topic = " ".join(words).strip()
    if not sys.stdin.isatty():
        sys.exit("learn: a session needs an interactive terminal (use learn --research for piped questions)")
    workdir = learn_dir()
    if log:
        log = os.path.abspath(log)  # relative to where you ran learn, before moving into workdir
    start_session(topic, None if no_log else (log or os.path.join(workdir, default_log(topic))), workdir)


if __name__ == "__main__":
    main()
